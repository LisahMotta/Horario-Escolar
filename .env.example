# Copie este arquivo para ".env" (local) e preencha com a string de conexão
# do seu projeto Supabase (Project Settings → Database → Connection string).
#
# Para desenvolvimento local, a connection string "direta" funciona bem.
# Para a Vercel (produção), use a connection string do "Connection pooling"
# (modo "Transaction", porta 6543) — funções serverless abrem muitas conexões
# de curta duração, e o pooler do Supabase evita esgotar o limite de conexões
# do Postgres.
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres
